JUYA_ENVIRONMENT=local
JUYA_SERVICE_NAME=juya-admin-api
JUYA_LOG_LEVEL=INFO
JUYA_DATABASE_URL=mysql+asyncmy://juya_admin_app:change-me@127.0.0.1:3306/juya
JUYA_MIGRATION_DATABASE_URL=mysql+pymysql://juya_migrate:change-me@127.0.0.1:3306/juya
JUYA_REDIS_URL=redis://127.0.0.1:6379/0
JUYA_INTERNAL_HMAC_SECRET=replace-with-at-least-32-random-bytes
JUYA_ALLOWED_INTERNAL_SERVICES=juya-miniapp-api
JUYA_MINIAPP_API_BASE_URL=http://juya-miniapp-api:8000
JUYA_OSS_REGION=cn-shenzhen
JUYA_OSS_BUCKET=juya-test
JUYA_OSS_EXPECTED_BUCKET=juya-test
JUYA_OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
JUYA_OSS_CREDENTIALS_MODE=environment
JUYA_OSS_RAM_ROLE_NAME=
# JUYA_OSS_CREDENTIALS_EXPIRES_AT=2026-10-01T00:00:00Z
JUYA_SIGNED_URL_TTL_SECONDS=300
# Supply test-only credentials outside source control. Production uses its own bucket/role.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
# V1.3: OCR and moderation are independent. Review is off in every environment by default.
JUYA_FFPROBE_PATH=ffprobe
JUYA_OCR_PROVIDER=disabled
JUYA_BAIDU_OCR_API_KEY=
JUYA_BAIDU_OCR_SECRET_KEY=
JUYA_CONTENT_SECURITY_ENABLED=false
JUYA_CONTENT_SECURITY_PROVIDER=disabled
JUYA_CONTENT_SECURITY_REGION=cn-shanghai
JUYA_CONTENT_SECURITY_ACCESS_KEY_ID=
JUYA_CONTENT_SECURITY_ACCESS_KEY_SECRET=
JUYA_CONTENT_SECURITY_LOCAL_FIXTURES_ONLY=false
