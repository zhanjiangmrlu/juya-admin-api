# Copy outside source control, e.g. /etc/juya/admin-api.env; chmod 600.
# Database URLs and production environment are supplied by the Compose file.
JUYA_LOG_LEVEL=INFO
JUYA_INTERNAL_HMAC_SECRET=
JUYA_ALLOWED_INTERNAL_SERVICES=juya-miniapp-api
# Leave miniapp API-dependent features unused until that backend is deployed.
JUYA_MINIAPP_API_BASE_URL=http://127.0.0.1:8001
JUYA_OSS_REGION=
JUYA_OSS_BUCKET=
JUYA_OSS_EXPECTED_BUCKET=
JUYA_OSS_ENDPOINT=
# Prefer an ECS RAM role with permissions scoped to the selected private bucket.
JUYA_OSS_CREDENTIALS_MODE=ecs_ram_role
JUYA_OSS_RAM_ROLE_NAME=
