# Copy outside source control, e.g. /etc/juya/compose.env; chmod 600.
# Generate DIFFERENT 48-character hexadecimal passwords for each account.
JUYA_ADMIN_API_IMAGE=juya-admin-api:ecs-2gb
JUYA_RUNTIME_ENV_FILE=/etc/juya/admin-api.env
JUYA_ADMIN_API_PORT=8000
JUYA_MYSQL_ROOT_PASSWORD=
JUYA_MYSQL_MIGRATION_PASSWORD=
JUYA_MYSQL_APP_PASSWORD=
